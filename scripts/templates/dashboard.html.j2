<!doctype html>
<html lang="pt-br">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>MIRO Intelligence</title>
<style>
  :root {
    --bg: #f7f7f5; --panel: #ffffff; --text: #1a1a1a; --muted: #6b6b6b;
    --border: #e5e5e2; --accent: #1a1a1a; --novo: #1a7f4b; --encerrada: #b3261e;
    --dist-bg: #eef1fb; --dist-text: #33409e;
  }
  * { box-sizing: border-box; }
  body { margin: 0; padding: 2.5rem 1.5rem; background: var(--bg); color: var(--text);
         font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  main { max-width: 1100px; margin: 0 auto; }
  .topbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
            gap: .75rem; margin-bottom: 1.5rem; }
  h1 { font-size: 1.5rem; margin: 0 0 .25rem; }
  .subtitle { color: var(--muted); font-size: .9rem; }
  .atualizado {
    display: inline-flex; align-items: center; gap: .4rem;
    background: var(--panel); border: 1px solid var(--border); border-radius: 999px;
    padding: .4rem .8rem; font-size: .8rem; color: var(--text); white-space: nowrap;
  }
  .atualizado .ponto {
    width: .5rem; height: .5rem; border-radius: 50%; background: var(--novo); flex: none;
  }

  .tab-input { position: absolute; opacity: 0; pointer-events: none; }
  .tabs-nav { display: flex; gap: .25rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border); }
  .tabs-nav label { padding: .65rem 1.1rem; cursor: pointer; font-size: .88rem; color: var(--muted);
                     border-bottom: 2px solid transparent; margin-bottom: -1px; }
  .tab-panel { display: none; }
  #tab-tendencias:checked ~ .tabs-nav label[for="tab-tendencias"],
  #tab-provas:checked ~ .tabs-nav label[for="tab-provas"] {
    color: var(--text); border-bottom-color: var(--accent); font-weight: 600;
  }
  #tab-tendencias:checked ~ #panel-tendencias,
  #tab-provas:checked ~ #panel-provas { display: block; }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.25rem; }
  section.card { background: var(--panel); border: 1px solid var(--border); border-radius: 10px;
            padding: 1.25rem 1.4rem; }
  h2 { font-size: 1.05rem; margin: 0 0 .15rem; }
  h2 a { color: inherit; text-decoration: none; }
  h2 a:hover { text-decoration: underline; }
  h3 { font-size: .78rem; text-transform: uppercase; letter-spacing: .02em; color: var(--muted);
       margin: 1rem 0 .4rem; font-weight: 500; }
  ul { margin: 0; padding-left: 1.1rem; font-size: .88rem; }
  li { margin-bottom: .3rem; }
  .badge { display: inline-block; font-size: .68rem; font-weight: 600; text-transform: uppercase;
           letter-spacing: .02em; padding: .05rem .35rem; border-radius: 4px; margin-left: .4rem; }
  .badge-novo { background: #e4f4ea; color: var(--novo); }
  .badge-dist { background: var(--dist-bg); color: var(--dist-text); margin-left: 0; margin-right: .3rem; }
  .encerrada { color: var(--encerrada); text-decoration: line-through; }
  .empty { color: var(--muted); font-size: .85rem; }
  .erro { color: var(--encerrada); font-size: .85rem; }
  .section-note { color: var(--muted); font-size: .85rem; margin: 0 0 1rem; }
  a { color: var(--accent); }

  table.provas-table { width: 100%; border-collapse: collapse; font-size: .88rem;
    background: var(--panel); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
  table.provas-table th, table.provas-table td { text-align: left; padding: .65rem .9rem;
    border-bottom: 1px solid var(--border); }
  table.provas-table tr:last-child td { border-bottom: none; }
  table.provas-table th { color: var(--muted); font-weight: 500; font-size: .72rem;
    text-transform: uppercase; letter-spacing: .02em; }
  table.provas-table td.data { white-space: nowrap; color: var(--muted); }

  footer { text-align: center; color: var(--muted); font-size: .78rem; margin-top: 2rem; }
</style>
</head>
<body>
<main>
  <div class="topbar">
    <div>
      <h1>MIRO Intelligence</h1>
      <p class="subtitle">Tendências dos concorrentes e provas de corrida</p>
    </div>
    <span class="atualizado">
      <span class="ponto"></span>
      {% if tendencias %}Última atualização: {{ tendencias.coletado_em | data_brasilia }}{% else %}Ainda sem dados coletados{% endif %}
    </span>
  </div>

  <input type="radio" name="tabs" id="tab-tendencias" class="tab-input" checked>
  <input type="radio" name="tabs" id="tab-provas" class="tab-input">

  <nav class="tabs-nav">
    <label for="tab-tendencias">Tendências dos concorrentes</label>
    <label for="tab-provas">Provas de corrida</label>
  </nav>

  <section class="tab-panel" id="panel-tendencias">
    {% if tendencias and tendencias.concorrentes %}
    <div class="grid">
      {% for chave, c in tendencias.concorrentes.items() %}
      <section class="card">
        <h2><a href="{{ c.url }}" target="_blank" rel="noopener">{{ c.nome }}</a></h2>

        {% if c.erro %}
          <p class="erro">Não foi possível coletar ({{ c.erro }}) — conferir manualmente.</p>
        {% else %}
          <h3>Promoções / banners</h3>
          {% if c.promocoes %}
          <ul>
            {% for p in c.promocoes %}
            <li>{{ p }}{% if p in c.promocoes_novas %}<span class="badge badge-novo">novo</span>{% endif %}</li>
            {% endfor %}
            {% for p in c.promocoes_encerradas %}
            <li class="encerrada">{{ p }}</li>
            {% endfor %}
          </ul>
          {% elif c.promocoes_encerradas %}
          <ul>
            {% for p in c.promocoes_encerradas %}
            <li class="encerrada">{{ p }}</li>
            {% endfor %}
          </ul>
          {% else %}
          <p class="empty">Nenhuma promoção detectada nesta coleta.</p>
          {% endif %}

          <h3>Lançamentos em destaque</h3>
          {% if c.lancamentos %}
          <ul>
            {% for l in c.lancamentos %}
            <li>
              {% if l.url %}<a href="{{ l.url }}" target="_blank" rel="noopener">{{ l.texto }}</a>{% else %}{{ l.texto }}{% endif %}
              {% if l.texto in c.lancamentos_novos %}<span class="badge badge-novo">novo</span>{% endif %}
            </li>
            {% endfor %}
          </ul>
          {% else %}
          <p class="empty">Nenhum lançamento detectado nesta coleta.</p>
          {% endif %}
        {% endif %}
      </section>
      {% endfor %}
    </div>
    {% else %}
    <p class="empty">Nenhum dado ainda. Rode <code>scrape_homepage_trends.py</code> ou aguarde a próxima execução automática.</p>
    {% endif %}
  </section>

  <section class="tab-panel" id="panel-provas">
    <p class="section-note">
      Meia maratona (21km) e maratona (42km) nos próximos meses
      {% if provas and not provas.erro %} · fonte: <a href="{{ provas.fonte_url }}" target="_blank" rel="noopener">{{ provas.fonte }}</a> · atualizado em {{ provas.coletado_em | data_brasilia }}{% endif %}
    </p>

    {% if provas and provas.erro %}
      <p class="erro">Não foi possível coletar ({{ provas.erro }}) — conferir manualmente.</p>
    {% elif provas and provas.provas %}
    <table class="provas-table">
      <thead>
        <tr><th>Data</th><th>Prova</th><th>Distância</th></tr>
      </thead>
      <tbody>
        {% for p in provas.provas %}
        <tr>
          <td class="data">{{ p.data | data_curta }}</td>
          <td>{% if p.url %}<a href="{{ p.url }}" target="_blank" rel="noopener">{{ p.nome }}</a>{% else %}{{ p.nome }}{% endif %}</td>
          <td>{% for d in p.distancias_km %}<span class="badge badge-dist">{{ d }}km</span>{% endfor %}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <p class="empty">Nenhuma prova de 21km/42km encontrada. Rode <code>scrape_provas.py</code> ou aguarde a próxima execução automática.</p>
    {% endif %}
  </section>

  <footer>MIRO Intelligence · gerado automaticamente</footer>
</main>
</body>
</html>
