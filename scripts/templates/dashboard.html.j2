<!doctype html>
<html lang="pt-br">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>MIRO Intelligence</title>
<style>
  :root {
    --bg: #f7f7f5; --panel: #ffffff; --text: #1a1a1a; --muted: #6b6b6b;
    --border: #e5e5e2; --good: #1a7f4b; --bad: #b3261e; --accent: #1a1a1a;
  }
  * { box-sizing: border-box; }
  body { margin: 0; padding: 2.5rem 1.5rem; background: var(--bg); color: var(--text);
         font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  main { max-width: 960px; margin: 0 auto; }
  h1 { font-size: 1.5rem; margin: 0 0 .25rem; }
  .subtitle { color: var(--muted); font-size: .9rem; margin-bottom: 2rem; }
  section { background: var(--panel); border: 1px solid var(--border); border-radius: 10px;
            padding: 1.5rem; margin-bottom: 1.5rem; }
  h2 { font-size: 1.05rem; margin: 0 0 .25rem; }
  .section-desc { color: var(--muted); font-size: .85rem; margin-bottom: 1rem; }
  table { width: 100%; border-collapse: collapse; font-size: .9rem; }
  th, td { text-align: left; padding: .55rem .6rem; border-bottom: 1px solid var(--border); }
  th { color: var(--muted); font-weight: 500; font-size: .78rem; text-transform: uppercase; letter-spacing: .02em; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  .diff-pos { color: var(--bad); }   /* MIRO mais caro que concorrente */
  .diff-neg { color: var(--good); } /* MIRO mais barato */
  .muted { color: var(--muted); }
  .confianca { font-size: .72rem; display: block; margin-top: .15rem; }
  .confianca-alta { color: var(--good); }
  .confianca-media { color: #a3791a; }
  .confianca-baixa { color: var(--bad); }
  a { color: var(--accent); }
  .empty { color: var(--muted); font-size: .85rem; padding: .5rem 0; }
  footer { text-align: center; color: var(--muted); font-size: .78rem; margin-top: 2rem; }
</style>
</head>
<body>
<main>
  <h1>MIRO Intelligence</h1>
  <p class="subtitle">
    {% if comparacao %}Atualizado em {{ comparacao.coletado_em }}{% else %}Ainda sem dados coletados{% endif %}
    <br><a href="tendencias.html">Ver painel de tendências →</a>
  </p>

  <section>
    <h2>Comparação de preços — concorrentes diretos</h2>
    <p class="section-desc">
      Seekdopa, Woom e Vorr — diferença % em relação ao preço MIRO (vermelho = MIRO mais caro, verde = MIRO mais barato).
      Pareamento automático por categoria + nome do produto — o % de match indica a confiança da correspondência
      (passe o mouse pra ver qual produto do concorrente foi usado).
    </p>
    {% if comparacao and comparacao.produtos %}
    <table>
      <thead>
        <tr>
          <th>Produto</th>
          <th class="num">MIRO</th>
          <th class="num">Seekdopa</th>
          <th class="num">Woom</th>
          <th class="num">Vorr</th>
        </tr>
      </thead>
      <tbody>
        {% for p in comparacao.produtos %}
        <tr>
          <td>{{ p.nome }}</td>
          <td class="num">{{ p.preco_miro | brl }}</td>
          {% for chave in ["seekdopa", "woom", "vorr"] %}
            {% set c = p.concorrentes.get(chave, {}) %}
            <td class="num">
              {% if c.preco is not none %}
                <a href="{{ c.url }}" target="_blank" rel="noopener" title="{{ c.match_nome or '' }}">{{ c.preco | brl }}</a>
                {% if c.diff_pct is not none %}
                  <br><span class="{{ 'diff-pos' if c.diff_pct > 0 else 'diff-neg' }}">{{ "%+.1f"|format(c.diff_pct) }}%</span>
                {% endif %}
                {% if c.origem == "manual" %}
                  <span class="confianca muted">manual</span>
                {% elif c.confianca is not none %}
                  <span class="confianca confianca-{{ c.confianca_nivel }}">match {{ (c.confianca * 100) | round | int }}%</span>
                {% endif %}
              {% else %}
                <span class="muted">sem equivalente</span>
              {% endif %}
            </td>
          {% endfor %}
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <p class="empty">Nenhum dado ainda. Rode <code>scrape_competitors.py</code> ou aguarde a próxima execução automática.</p>
    {% endif %}
  </section>

  <section>
    <h2>Referência de mercado — tendência</h2>
    <p class="section-desc">Nike e Adidas — sem comparação direta, só acompanhamento de preços/lançamentos de corrida masculina</p>
    {% if referencia and referencia.marcas %}
      {% for chave, marca in referencia.marcas.items() %}
        <h3 style="font-size:.9rem; margin: 1rem 0 .4rem;">{{ marca.nome }}</h3>
        {% if marca.produtos %}
        <table>
          <thead><tr><th>Produto</th><th class="num">Preço</th></tr></thead>
          <tbody>
            {% for prod in marca.produtos %}
            <tr>
              <td>{{ prod.nome_site or "-" }}</td>
              <td class="num">{{ prod.preco | brl }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
        {% else %}
        <p class="empty">Sem produtos coletados ainda para {{ marca.nome }}.</p>
        {% endif %}
      {% endfor %}
    {% else %}
    <p class="empty">Nenhum dado ainda. Rode <code>scrape_reference.py</code> ou aguarde a próxima execução automática.</p>
    {% endif %}
  </section>

  <footer>MIRO Intelligence · gerado automaticamente</footer>
</main>
</body>
</html>
