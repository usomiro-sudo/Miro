<!doctype html>
<html lang="pt-br">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>MIRO Intelligence — Tendências</title>
<style>
  :root {
    --bg: #f7f7f5; --panel: #ffffff; --text: #1a1a1a; --muted: #6b6b6b;
    --border: #e5e5e2; --good: #1a7f4b; --bad: #b3261e; --accent: #1a1a1a; --tag-bg: #f0efe9;
  }
  * { box-sizing: border-box; }
  body { margin: 0; padding: 2.5rem 1.5rem; background: var(--bg); color: var(--text);
         font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  main { max-width: 960px; margin: 0 auto; }
  h1 { font-size: 1.5rem; margin: 0 0 .25rem; }
  .subtitle { color: var(--muted); font-size: .9rem; margin-bottom: 2rem; }
  .subtitle a { color: var(--accent); }
  section { background: var(--panel); border: 1px solid var(--border); border-radius: 10px;
            padding: 1.5rem; margin-bottom: 1.5rem; }
  h2 { font-size: 1.1rem; margin: 0 0 .25rem; }
  h3 { font-size: .9rem; margin: 1rem 0 .4rem; color: var(--muted); text-transform: uppercase; letter-spacing: .02em; }
  .section-desc { color: var(--muted); font-size: .85rem; margin-bottom: 1rem; }
  .concorrente-header { margin-bottom: .5rem; }
  a.site-link { font-size: .8rem; }
  .descricao { font-size: .9rem; color: var(--muted); margin: 0 0 .5rem; }
  ul.destaques { margin: 0; padding-left: 1.1rem; font-size: .9rem; }
  ul.destaques li { margin-bottom: .3rem; }
  .badge { display: inline-block; font-size: .68rem; padding: .1rem .45rem; border-radius: 999px;
           text-transform: uppercase; letter-spacing: .02em; margin-right: .35rem; }
  .badge-novo { background: #e4f4ea; color: var(--good); }
  .badge-sumiu { background: #f7e6e4; color: var(--bad); }
  .termos { display: flex; flex-wrap: wrap; gap: .4rem; }
  .termo { background: var(--tag-bg); border-radius: 6px; padding: .25rem .55rem; font-size: .8rem; }
  .termo-count { color: var(--muted); }
  .muted { color: var(--muted); }
  a { color: var(--accent); }
  .empty { color: var(--muted); font-size: .85rem; padding: .5rem 0; }
  footer { text-align: center; color: var(--muted); font-size: .78rem; margin-top: 2rem; }
</style>
</head>
<body>
<main>
  <h1>MIRO Intelligence — Tendências</h1>
  <p class="subtitle">
    {% if tendencias %}Atualizado em {{ tendencias.coletado_em }}{% else %}Ainda sem dados coletados{% endif %}
    <br><a href="index.html">← Comparação de preços</a>
  </p>

  <section>
    <p class="section-desc" style="margin-bottom:0;">
      Foco em produto e marketing, não em preço: leitura da página principal de Seekdopa, Woom e Vorr — título,
      descrição, headlines/banners em destaque — comparada com a leitura anterior pra apontar o que mudou, mais
      os termos que mais aparecem nos destaques recentes. É insumo pra projeção de tendência do MIRO, não conclusão pronta.
    </p>
  </section>

  {% if not tendencias %}
  <section>
    <p class="empty">Nenhum dado ainda. Rode <code>monitor_tendencias.py</code> ou aguarde a próxima execução automática.</p>
  </section>
  {% elif tendencias.primeira_leitura %}
  <section>
    <p class="empty">
      Essa é a primeira leitura registrada — ainda não há uma execução anterior pra comparar.
      "Novo desde a última leitura" aparece a partir da <strong>próxima</strong> execução.
      Termos em alta já aparecem abaixo, com base na leitura atual.
    </p>
  </section>
  {% endif %}

  {% if tendencias and tendencias.concorrentes %}
    {% for chave, c in tendencias.concorrentes.items() %}
    <section>
      <div class="concorrente-header">
        <h2>{{ c.nome }}</h2>
      </div>

      {% if c.falha_leitura %}
      <p class="empty" style="color: var(--bad);">Falha ao acessar a home nessa leitura — sem dados novos dessa vez, deve normalizar na próxima.</p>
      {% else %}
        {% if c.titulo %}<p class="descricao"><strong>{{ c.titulo }}</strong></p>{% endif %}
        {% if c.descricao %}<p class="descricao">{{ c.descricao }}</p>{% endif %}

        <h3>Destaques na home hoje ({{ c.destaques | length }})</h3>
        {% if c.destaques %}
        <ul class="destaques">
          {% for d in c.destaques %}
          <li>
            {% if d in c.novos_destaques %}<span class="badge badge-novo">novo</span>{% endif %}
            {{ d }}
          </li>
          {% endfor %}
        </ul>
        {% else %}
        <p class="empty">Nenhum headline/banner identificado na home.</p>
        {% endif %}

        {% if c.destaques_sumidos %}
        <h3>Sumiram da home desde a última leitura ({{ c.destaques_sumidos | length }})</h3>
        <ul class="destaques">
          {% for d in c.destaques_sumidos %}
          <li><span class="badge badge-sumiu">sumiu</span> {{ d }}</li>
          {% endfor %}
        </ul>
        {% endif %}

        {% if c.produtos_destaque %}
        <h3>Produtos em destaque na home hoje ({{ c.produtos_destaque | length }})</h3>
        <ul class="destaques">
          {% for p in c.produtos_destaque %}
          <li>{% if p.url %}<a href="{{ p.url }}" target="_blank" rel="noopener">{{ p.nome_site or "-" }}</a>{% else %}{{ p.nome_site or "-" }}{% endif %}</li>
          {% endfor %}
        </ul>
        {% endif %}

        <h3>Termos em alta nos destaques recentes (últimos {{ 60 }} dias)</h3>
        {% if c.termos_em_alta %}
        <div class="termos">
          {% for termo, contagem in c.termos_em_alta %}
          <span class="termo">{{ termo }} <span class="termo-count">×{{ contagem }}</span></span>
          {% endfor %}
        </div>
        {% else %}
        <p class="empty">Sem termos suficientes pra destacar ainda.</p>
        {% endif %}
      {% endif %}
    </section>
    {% endfor %}
  {% endif %}

  <footer>MIRO Intelligence · gerado automaticamente · análise de termos é heurística simples, não NLP</footer>
</main>
</body>
</html>
